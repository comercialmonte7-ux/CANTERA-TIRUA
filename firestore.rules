rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función central de administración
    function isAdmin() {
      return (request.auth != null && request.auth.token.email == 'mari.ricardo@gmail.com') || 
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN');
    }

    // Ruta para verificar conectividad
    match /test/connection {
      allow read: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function canViewData() {
      return isAdmin() || hasRole('ADMIN') || hasRole('MANAGER') || hasRole('VIEWER') || hasRole('OPERATOR');
    }

    function canAddDispatch() {
      return isAdmin() || hasRole('ADMIN') || hasRole('MANAGER') || hasRole('OPERATOR');
    }

    function isValidDispatch(data) {
      return data.keys().hasAll(['date', 'truckPlate', 'truckDriver', 'materialVolume', 'materialType', 'creatorId', 'creatorName', 'createdAt']) &&
             data.date is timestamp &&
             data.truckPlate is string && data.truckPlate.size() > 0 &&
             data.truckDriver is string && data.truckDriver.size() > 0 &&
             data.materialVolume is number &&
             data.materialType is string &&
             data.creatorId == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidInventory(data) {
      return data.keys().hasAll(['materialType', 'currentStock', 'unit', 'updatedAt']) &&
             data.materialType is string &&
             data.currentStock is number &&
             data.updatedAt == request.time;
    }

    // Colección de Despachos
    match /dispatches/{dispatchId} {
      allow read: if canViewData();
      allow create: if canAddDispatch() && isValidDispatch(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Colección de Inventario
    match /inventory/{itemId} {
      allow read: if canViewData();
      allow write: if canAddDispatch() && isValidInventory(request.resource.data);
    }

    // Colección de Usuarios/Perfiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // Denegación por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
